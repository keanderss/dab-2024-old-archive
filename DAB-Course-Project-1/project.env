# Database configuration for PostgreSQL (running in container called "database-server-dab-p1-35c4c5b9-0b01-4e39-8872-083da105c64c")
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database

# Database configuration for Flyway (used for database migrations)
FLYWAY_USER=username
FLYWAY_PASSWORD=password
FLYWAY_URL=jdbc:postgresql://database-server-dab-p1-35c4c5b9-0b01-4e39-8872-083da105c64c:5432/database

# Database configuration for PostgreSQL driver
PGUSER=username
PGPASSWORD=password
PGHOST=database-server-dab-p1-35c4c5b9-0b01-4e39-8872-083da105c64c
PGPORT=5432
PGDATABASE=database

# Deno cache location (avoid reloading depedencies over and over)
DENO_DIR=/app-cache

# Docker project name
COMPOSE_PROJECT_NAME="dab-course-project-1"